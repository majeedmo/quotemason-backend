# Copy to backend/.env and fill in. Never commit .env.

# The contractor this deployment serves (one process = one contractor).
# Onboarding another contractor = new values here + their corpus ingested
# under their CONTRACTOR_ID — no code changes. Defaults match config.py.
CONTRACTOR_ID=company-a
CONTRACTOR_NAME=Company A
BRAND_NAME=Maplewood Renovations
ZONING_JURISDICTION=cambridge

# Embeddings (OpenAI-direct, locked: text-embedding-3-small)
OPENAI_API_KEY=

# Qdrant. Leave QDRANT_URL empty to use a local on-disk store at backend/qdrant_local/
# (fine for dev; use Qdrant Cloud URL + key for deploys).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=estimator_corpus

# Agent models via OpenRouter (decided 2026-07-12 — see project-brief.md Task 2)
OPENROUTER_API_KEY=
DRAFTING_MODEL=anthropic/claude-sonnet-5
INTAKE_MODEL=anthropic/claude-haiku-4.5
# Cost experiment 2026-07-25 (see docs/capstone-progress.md) — same value as
# INTAKE_MODEL today, but its own setting since takeoff's accuracy/cost
# trade-off is independent of intake's.
TAKEOFF_MODEL=anthropic/claude-haiku-4.5
JUDGE_MODEL=openai/gpt-5.1

# Tavily (pricing search tool)
TAVILY_API_KEY=

# Upstash Redis (LangGraph checkpointer)
UPSTASH_REDIS_URL=

# Neon Postgres (quote_drafts review store; structured past-project pre-filter is a Task 6 candidate)
DATABASE_URL=

# LangSmith tracing — turns on automatically whenever LANGSMITH_API_KEY is
# set (config.py exports the env vars LangChain reads). Set false to disable.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=quotemason
LANGSMITH_TRACING=true

# Browser origins allowed to call the API, comma-separated
# (Next.js dev server by default; 3001 covers Next's fallback port when
# 3000 is taken; add the Vercel URL for the deploy)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Demo-only "Estimator Login" gate in front of the frontend's /dashboard page.
# Not real auth (no hashing/sessions/DB) — hardcoded credential check only.
ESTIMATOR_DEMO_USER=
ESTIMATOR_DEMO_PASSWORD=
